# Copy to backend/.env for a private server configuration.
# Local development uses loopback. Set REQUIRE_AUTH=1 and use HTTPS for deployment.
KNOWLEDGE_DESK_REQUIRE_AUTH=0
KNOWLEDGE_DESK_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Built frontend, optional. Use frontend/dist for a single HTTPS origin.
KNOWLEDGE_DESK_STATIC_DIR=
KNOWLEDGE_DESK_SUPABASE_URL=
KNOWLEDGE_DESK_SUPABASE_PUBLISHABLE_KEY=
KNOWLEDGE_DESK_DATABASE_URL=
KNOWLEDGE_DESK_STORAGE_EMAIL=
KNOWLEDGE_DESK_STORAGE_PASSWORD=

# SQLite/Chroma only. Blank manifest and index select the bundled defaults.
KNOWLEDGE_DESK_DB_PATH=data/knowledge_desk.sqlite3
KNOWLEDGE_DESK_MANIFEST=
KNOWLEDGE_DESK_INDEX=
KNOWLEDGE_DESK_CHUNK_SIZE=400
KNOWLEDGE_DESK_MAX_DISTANCE=0.18
KNOWLEDGE_DESK_EMBEDDING_CACHE=data/.model-cache

# Server only. The supported model and embedding revision are defined in code.
OPENAI_API_KEY=
KNOWLEDGE_DESK_MODEL_TIMEOUT_SECONDS=15
KNOWLEDGE_DESK_EXPENSIVE_REQUESTS_PER_MINUTE=30
KNOWLEDGE_DESK_N8N_TIMEOUT_SECONDS=5
KNOWLEDGE_DESK_N8N_TEST_URL=
KNOWLEDGE_DESK_N8N_SECRET=

# Optional n8n journal importer only. Keep in backend/.env.n8n.
KNOWLEDGE_DESK_N8N_DATABASE_URL=

# Frontend only (frontend/.env.local or the npm build environment).
# VITE_API_BASE_URL=http://127.0.0.1:8000
